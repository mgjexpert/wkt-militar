# App
NEXT_PUBLIC_APP_URL=https://treinomilitar.novidades.store
AUTH_SECRET=replace-with-a-long-random-secret
DEMO_ACCESS_CODE=replace-for-preview-only

# Database
# Preferred generic name:
DATABASE_URL=
# The app also auto-detects Vercel/Neon-prefixed variables such as:
# wkt_DATABASE_URL, wkt_POSTGRES_URL, wkt_POSTGRES_PRISMA_URL,
# wkt_DATABASE_URL_UNPOOLED and wkt_POSTGRES_URL_NON_POOLING.

# Product
WKT_PRICE_CENTS=6700

# XPayments PIX S2S
XPAYMENTS_MODE=mock
XPAYMENTS_API_KEY=
XPAYMENTS_CHARGE_URL=https://api.xpayments.digital/api/v1/payments/charge

# Webhook endpoint:
# https://treinomilitar.novidades.store/api/webhooks/xpayments
#
# XPAYMENTS_WEBHOOK_SECRET may be stored, but is intentionally NOT used
# until XPayments documents the exact signing header/HMAC verification scheme.
XPAYMENTS_WEBHOOK_SECRET=
